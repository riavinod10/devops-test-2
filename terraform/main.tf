# Generates the connection files consumed by Ansible (ansible/generated/*).

locals {
  output_dir = "${path.module}/../ansible/generated"

  backend_k8s_url   = "http://${var.host_address}:${var.backend_nodeport}"
  frontend_k8s_url  = "http://${var.host_address}:${var.frontend_nodeport}"
  backend_dock_url  = "http://${var.host_address}:${var.docker_backend_host_port}"
  frontend_dock_url = "http://${var.host_address}:${var.docker_frontend_host_port}"

  connection = {
    project      = var.project_name
    environment  = var.environment
    app_version  = var.app_version
    generated_by = "terraform"
    kubernetes = {
      namespace = var.k8s_namespace
      backend = {
        service      = "payment-backend"
        service_port = var.backend_service_port
        node_port    = var.backend_nodeport
        cluster_dns  = "payment-backend.${var.k8s_namespace}.svc.cluster.local"
        url          = local.backend_k8s_url
        health_url   = "${local.backend_k8s_url}/health"
      }
      frontend = {
        service      = "payment-frontend"
        service_port = var.frontend_service_port
        node_port    = var.frontend_nodeport
        url          = local.frontend_k8s_url
        health_url   = "${local.frontend_k8s_url}/healthz"
      }
    }
    docker = {
      network = "payments-net"
      backend = {
        container  = "payment-backend"
        image      = "payment-backend:${var.app_version}"
        host_port  = var.docker_backend_host_port
        health_url = "${local.backend_dock_url}/health"
      }
      frontend = {
        container  = "payment-frontend"
        image      = "payment-frontend:${var.app_version}"
        host_port  = var.docker_frontend_host_port
        health_url = "${local.frontend_dock_url}/healthz"
      }
    }
  }
}

resource "local_file" "connection_json" {
  filename = "${local.output_dir}/connection.json"
  content  = "${jsonencode(local.connection)}\n"
}

resource "local_file" "app_env" {
  filename = "${local.output_dir}/app.env"
  content  = <<-EOT
    # Generated by Terraform - do not edit by hand
    PROJECT_NAME=${var.project_name}
    APP_ENV=${var.environment}
    APP_VERSION=${var.app_version}
    K8S_NAMESPACE=${var.k8s_namespace}
    BACKEND_HOST=payment-backend
    BACKEND_PORT=${var.backend_service_port}
    BACKEND_URL=${local.backend_k8s_url}
    FRONTEND_URL=${local.frontend_k8s_url}
  EOT
}

resource "local_file" "ansible_inventory" {
  filename = "${local.output_dir}/inventory.ini"
  content  = <<-EOT
    # Generated by Terraform - Ansible inventory for host configuration validation.
    # Both tiers are validated from the local WSL host (ansible_connection=local).

    [payment_frontend]
    frontend-node ansible_connection=local tier=frontend service_port=${var.frontend_service_port} node_port=${var.frontend_nodeport} health_path=/healthz

    [payment_backend]
    backend-node ansible_connection=local tier=backend service_port=${var.backend_service_port} node_port=${var.backend_nodeport} health_path=/health

    [payment_engine:children]
    payment_frontend
    payment_backend

    [payment_engine:vars]
    ansible_python_interpreter=/usr/bin/python3
    app_version=${var.app_version}
    app_environment=${var.environment}
    k8s_namespace=${var.k8s_namespace}
    endpoint_host=${var.host_address}
  EOT
}
